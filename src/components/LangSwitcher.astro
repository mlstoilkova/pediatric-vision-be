---
import { locales, localeNames, localeCodes, type Locale } from '../i18n/config';
import { pagePath, type PageRef } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** The current page, so each link goes to the same page (and the same article) in that language. */
  page: PageRef;
}

const { locale, page } = Astro.props;
const ui = getUi(locale);
---

<div class="lang" data-lang>
  <button
    class="lang__button"
    type="button"
    aria-expanded="false"
    aria-controls="lang-menu"
    aria-label={`${ui.lang.label}: ${localeCodes[locale]}`}
    data-lang-button
  >
    <span aria-hidden="true">{localeCodes[locale]}</span>
    <span class="lang__caret" aria-hidden="true">▼</span>
  </button>
  <ul class="lang__menu" id="lang-menu" hidden data-lang-menu>
    {
      locales.map((l) => (
        <li>
          <a
            href={pagePath(page, l)}
            lang={l}
            hreflang={l}
            aria-current={l === locale ? 'true' : undefined}
            class:list={['lang__item', { 'lang__item--current': l === locale }]}
          >
            {localeNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang {
    position: relative;
    justify-self: end;
  }

  /* Desktop: cream pill */
  .lang__button {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 12px 15px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--c-cream);
    font-size: 14px;
    font-weight: 600;
    color: var(--c-navy);
  }

  .lang__caret {
    font-size: 12px;
    opacity: 0.7;
  }

  .lang__menu {
    position: absolute;
    top: 58px;
    right: 0;
    z-index: 60;
    min-width: 150px;
    display: flex;
    flex-direction: column;
    padding: 6px;
    border-radius: 18px;
    background: var(--c-cream);
    box-shadow: var(--shadow-float);
  }

  .lang__item {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 12px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--c-navy);
  }

  .lang__item:hover {
    background: var(--c-peach);
  }

  .lang__item--current {
    font-weight: 600;
    color: var(--c-ink);
  }

  /* Mobile: hairline pill with teal text */
  @media (max-width: 760px) {
    .lang__button {
      gap: 6px;
      min-height: 42px;
      padding: 0 13px;
      border: 1px solid var(--c-hairline);
      background: transparent;
      font-size: 13px;
      color: var(--c-teal-text);
    }

    .lang__menu {
      top: 50px;
    }
  }
</style>
