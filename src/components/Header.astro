---
import logo from '../assets/logo.svg';
import LangSwitcher from './LangSwitcher.astro';
import { getUi } from '../i18n/ui';
import { pagePath, type PageRef } from '../i18n/routes';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  page: PageRef;
}

const { locale, page } = Astro.props;
const ui = getUi(locale);

// Order and labels follow the prototype: Home · Afspraak (clinics) · Over mij · Aandoeningen (articles)
const navItems = [
  { key: 'home', label: ui.nav.home },
  { key: 'clinics', label: ui.nav.clinics },
  { key: 'about', label: ui.nav.about },
  { key: 'conditions', label: ui.nav.conditions },
] as const;

const items = navItems.map((item) => ({
  ...item,
  href: pagePath({ page: item.key }, locale),
  active: page.page === item.key,
  // aria-current="page" only on the exact page; an article keeps its section highlighted
  current: page.page === item.key && !page.article,
}));
---

<header class="header" data-header data-shrunk="false">
  <div class="header__inner">
    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={ui.menu.open}
      data-burger
      data-label-open={ui.menu.open}
      data-label-close={ui.menu.close}
    >
      <svg class="burger__open" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 5.5h14M3 10h14M3 14.5h14"></path>
      </svg>
      <svg class="burger__close" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15"></path>
      </svg>
    </button>

    <a class="logo" href={pagePath({ page: 'home' }, locale)}>
      <img src={logo.src} width={logo.width} height={logo.height} alt={ui.site.name} />
    </a>

    <div class="header__row">
      <span class="header__spacer" aria-hidden="true"></span>
      <nav class="desknav" aria-label={ui.nav.label}>
        {
          items.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              class:list={{ 'is-active': item.active }}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="header__lang">
        <LangSwitcher locale={locale} page={page} />
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav aria-label={ui.nav.label}>
      <ul class="mobile-menu__list">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                class:list={['mobile-menu__item', { 'is-active': item.active }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="mobile-menu__book" href={pagePath({ page: 'clinics' }, locale)}>{ui.book}</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = header?.querySelector<HTMLElement>('[data-mobile-menu]');
  const lang = header?.querySelector<HTMLElement>('[data-lang]');
  const langButton = header?.querySelector<HTMLButtonElement>('[data-lang-button]');
  const langMenu = header?.querySelector<HTMLElement>('[data-lang-menu]');

  if (header && burger && menu && lang && langButton && langMenu) {
    const SHRINK_AFTER = 260; // px scrolled (mobile only, see CSS)

    const setMenu = (open: boolean, returnFocus = false) => {
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) ?? '');
      if (open) setLang(false);
      if (!open && returnFocus) burger.focus();
    };

    const setLang = (open: boolean, returnFocus = false) => {
      langMenu.hidden = !open;
      langButton.setAttribute('aria-expanded', String(open));
      if (open) setMenu(false);
      if (!open && returnFocus) langButton.focus();
    };

    burger.addEventListener('click', () => setMenu(Boolean(menu.hidden)));
    langButton.addEventListener('click', () => setLang(Boolean(langMenu.hidden)));

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (!langMenu.hidden) setLang(false, true);
      else if (!menu.hidden) setMenu(false, true);
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!langMenu.hidden && !lang.contains(target)) setLang(false);
      if (!menu.hidden && !header.contains(target)) setMenu(false);
    });

    // Keyboard users tabbing out of the language menu close it
    lang.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!langMenu.hidden && next && !lang.contains(next)) setLang(false);
    });

    // Leaving the mobile layout closes the burger menu
    window.matchMedia('(min-width: 761px)').addEventListener('change', (event) => {
      if (event.matches) setMenu(false);
    });

    // Header shrinks after the hero on mobile
    const onScroll = () => {
      header.dataset.shrunk = String(window.scrollY > SHRINK_AFTER);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--c-header);
    backdrop-filter: blur(10px);
  }

  .header__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 16px var(--pad-x) 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transition: padding 0.22s ease;
  }

  .logo {
    display: block;
  }

  .logo img {
    width: 154px;
    height: auto;
    transition: width 0.22s ease;
  }

  .header__row {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .header__lang {
    justify-self: end;
  }

  .desknav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .desknav a {
    padding: 11px 18px;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: 500;
    color: var(--c-navy);
    white-space: nowrap;
  }

  .desknav a:hover {
    background: var(--c-blush);
  }

  /* Active item: blush pill, weight 600 */
  .desknav a.is-active {
    background: var(--c-blush);
    font-weight: 600;
    color: var(--c-ink);
  }

  @media (max-width: 980px) {
    .desknav a {
      padding: 11px 12px;
      font-size: 14px;
    }
  }

  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--c-cream);
    color: var(--c-navy);
  }

  .burger__close,
  .burger[aria-expanded='true'] .burger__open {
    display: none;
  }

  .burger[aria-expanded='true'] .burger__close {
    display: block;
  }

  .mobile-menu {
    padding: 8px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-menu__item {
    display: block;
    padding: 14px 18px;
    border-radius: 16px;
    background: var(--c-cream);
    font-size: 17px;
    font-weight: 500;
    color: var(--c-navy);
  }

  .mobile-menu__item.is-active {
    background: var(--c-blush);
    font-weight: 600;
  }

  .mobile-menu__book {
    display: block;
    margin-top: 6px;
    padding: 16px 22px;
    border-radius: var(--r-pill);
    background: var(--c-coral);
    color: var(--c-ink);
    font-size: 16px;
    font-weight: 700;
    text-align: center;
  }

  .mobile-menu__book:hover {
    background: var(--c-coral-hover);
    color: var(--c-ink);
  }

  /* Mobile: burger left, logo centred, language pill right */
  @media (max-width: 760px) {
    .header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0 10px;
      padding: 10px 18px;
    }

    .header__row {
      display: contents;
    }

    .header__spacer,
    .desknav {
      display: none;
    }

    .logo {
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
    }

    .logo img {
      width: 112px;
    }

    .burger {
      display: inline-flex;
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }

    .header__lang {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    /* After the hero (≈260px) the header shrinks and the language pill hides */
    .header[data-shrunk='true'] .header__inner {
      padding: 5px 18px;
    }

    .header[data-shrunk='true'] .logo img {
      width: 86px;
    }

    .header[data-shrunk='true'] .header__lang {
      display: none;
    }
  }

  @media (min-width: 761px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>
