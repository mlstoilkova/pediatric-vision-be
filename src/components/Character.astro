---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** The widest size (px) it is shown at. A sharper copy for high-density screens is made too. */
  width: number;
  /** Seconds for one bob. Leave out for a still character. Off for people who prefer reduced motion. */
  bob?: number;
  class?: string;
  style?: string;
}

const { src, width, bob, class: className, style } = Astro.props;
---

<!-- Characters are decoration: no alt text. Never recolour or redraw them. -->
<Image
  src={src}
  alt=""
  width={width}
  densities={[1.5, 2]}
  loading="lazy"
  decoding="async"
  class:list={['character', { bob: bob !== undefined }, className]}
  style={[bob !== undefined ? `--bob-duration:${bob}s` : '', style ?? ''].filter(Boolean).join(';') || undefined}
/>

<style>
  .character {
    height: auto;
    flex: 0 0 auto;
  }
</style>
