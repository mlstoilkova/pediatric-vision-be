---
import ArticleCard from '../components/ArticleCard.astro';
import PageHead from '../components/PageHead.astro';
import { getSingleton } from '../lib/content';
import { getArticles } from '../lib/articles';
import { getClinics } from '../lib/clinics';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/config';

import flower from '../assets/characters/flower-glasses.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const c = await getSingleton('pageConditions', locale);
const ui = await getSingleton('settingsUi', locale);
const tech = getUi(locale);
const clinics = await getClinics(locale);
const [featured, ...others] = await getArticles(locale);
const card = { readLabel: ui.labels.readArticle, readingTimeLabel: ui.labels.readingTime };
---

<section class="container head">
  <PageHead eyebrow={c.header.eyebrow} title={c.header.title} lead={c.header.lead} character={flower} characterWidth={160} />
</section>

<!-- Booking bar: one outlined button per clinic, straight to that clinic's own booking system -->
<section class="container bar-section">
  <div class="bar">
    <div class="bar__text">
      <h2 class="bar__title">{c.booking.title}</h2>
      <p class="bar__lead">{c.booking.text}</p>
    </div>
    <div class="books">
      {
        clinics.map((clinic) => (
          <a class="book" href={clinic.bookingUrl} target="_blank" rel="noopener">
            {clinic.city}<span class="book__arrow" aria-hidden="true">↗</span>
            <span class="sr-only">{tech.newTab}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="container list">
  {featured && <ArticleCard article={featured} variant="featured" {...card} />}
  <div class="grid">
    {others.map((article) => <ArticleCard article={article} variant="list" {...card} />)}
  </div>
</section>
<div class="end"></div>

<style>
  .head {
    padding-top: clamp(36px, 5vw, 72px);
  }

  .bar-section {
    padding-top: clamp(32px, 4vw, 48px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: clamp(20px, 2.6vw, 32px) clamp(22px, 3vw, 40px);
    border-radius: var(--r-card);
    background: var(--c-cream);
  }

  .bar__text {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bar__title {
    font-size: clamp(21px, 1.9vw, 26px);
    line-height: 1.2;
    font-weight: 700;
    color: var(--c-ink);
  }

  .bar__lead {
    font-size: 16px;
    line-height: 1.55;
    color: var(--c-muted);
  }

  .books {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    flex: 1 1 420px;
  }

  .book {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(27, 62, 112, 0.22);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-navy);
    transition: background-color 0.15s ease;
  }

  .book:hover {
    background: var(--c-blush);
    color: var(--c-navy);
  }

  .book__arrow {
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .books {
      grid-template-columns: minmax(0, 1fr);
      flex-basis: 100%;
    }
  }

  .list {
    padding-top: clamp(40px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 276px), 1fr));
    gap: 18px;
  }

  .end {
    height: var(--section-top);
  }
</style>
