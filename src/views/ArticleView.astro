---
import Character from '../components/Character.astro';
import Photo from '../components/Photo.astro';
import Prose from '../components/Prose.astro';
import ReadingTime from '../components/ReadingTime.astro';
import { getSingleton } from '../lib/content';
import { getArticles, type Article } from '../lib/articles';
import { faqHref } from '../lib/faq';
import { escapeHtml } from '../lib/markdown';
import { pagePath } from '../i18n/routes';
import type { Locale } from '../i18n/config';

import triangle from '../assets/characters/attention-triangle.png';

interface Props {
  locale: Locale;
  article: Article;
}
const { locale, article } = Astro.props;

const labels = await getSingleton('pageArticle', locale);
const ui = await getSingleton('settingsUi', locale);
const others = (await getArticles(locale)).filter((a) => a.id !== article.id);
const list = (items: string[]) => `<ul>${items.map((item) => `<li>${escapeHtml(item)}</li>`).join('')}</ul>`;
---

<article class="container article">
  <header class="intro">
    <a class="back" href={pagePath({ page: 'conditions' }, locale)}><span class="back__arrow" aria-hidden="true">←</span> {labels.backLabel}</a>
    <div class="meta"><ReadingTime label={ui.labels.readingTime} minutes={article.readingTime} /></div>
    <h1 class="title">{article.title}</h1>
    <p class="summary">{article.summary}</p>
  </header>

  <Photo
    src={article.image}
    alt={article.imageAlt}
    widths={[640, 960, 1100, 1600]}
    sizes="(min-width: 1181px) 1100px, 100vw"
    eager
    class="cover"
  />

  <div class="body">
    {
      article.blocks.map((block) =>
        block.type === 'text' ? (
          <Prose html={block.html} size="article" />
        ) : (
          <div class="flag">
            <Character src={triangle} width={84} class="flag__char" />
            <div class="flag__body">
              <span class="t-eyebrow">{labels.redFlagsLabel}</span>
              {block.title && <p class="flag__title">{block.title}</p>}
              {block.items.length > 0 && <Prose html={list(block.items)} size="article" />}
            </div>
          </div>
        ),
      )
    }
  </div>
</article>

<section class="container also">
  <h2 class="t-h2 also__title">{labels.alsoRead}</h2>
  <div class="also__grid">
    {
      others.map((other) => (
        <a class="also__card" href={other.href}>
          <Photo src={other.image} alt="" widths={[320, 480, 640]} sizes="(min-width: 1101px) 28vw, (min-width: 761px) 45vw, 90vw" class="also__img" />
          <div class="also__body"><h3 class="t-h3-card">{other.title}</h3></div>
        </a>
      ))
    }
  </div>
  <a class="faqcard" href={faqHref(locale, article.faqTopic)}>
    <span class="faqcard__text">
      <span class="faqcard__title">{labels.faqCard.title}</span>
      <span class="faqcard__lead">{labels.faqCard.text}</span>
    </span>
    <span class="faqcard__more">{labels.faqCard.buttonLabel} <span class="faqcard__arrow" aria-hidden="true">→</span></span>
  </a>
</section>

<style>
  .article {
    padding-top: clamp(28px, 4vw, 56px);
  }

  .intro {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    color: var(--c-navy);
  }

  .back__arrow {
    color: var(--c-coral);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }

  .title {
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--c-ink);
    overflow-wrap: break-word;
  }

  html:not([lang='nl']) .title {
    hyphens: auto;
  }

  .summary {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
    color: var(--c-navy);
  }

  .article :global(.cover) {
    display: block;
    width: 100%;
    max-width: 1100px;
    height: clamp(240px, 34vw, 460px);
    object-fit: cover;
    border-radius: var(--r-card);
    margin: clamp(28px, 4vw, 48px) auto 0;
  }

  @media (max-width: 760px) {
    .article :global(.cover) {
      height: 220px;
    }
  }

  .body {
    max-width: 720px;
    margin: 0 auto;
    padding-top: clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Red-flag box */
  .flag {
    margin: 10px 0;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-step);
    background: var(--c-blush);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px 24px;
    align-items: start;
  }

  .flag :global(.flag__char) {
    width: 84px;
    height: auto;
  }

  .flag__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .flag__title {
    font-size: 18px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--c-ink);
  }

  @media (max-width: 760px) {
    .flag {
      grid-template-columns: minmax(0, 1fr);
    }

    .flag :global(.flag__char) {
      width: 64px;
    }
  }

  /* Also read */
  .also {
    padding-top: var(--section-top);
  }

  .also__title {
    margin-bottom: 28px;
  }

  .also__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 276px), 1fr));
    gap: 18px;
  }

  .also__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: var(--r-card);
    background: var(--c-cream);
    transition: background-color 0.15s ease;
  }

  .also__card:hover {
    background: var(--c-blush);
    color: inherit;
  }

  .also__card :global(.also__img) {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: 20px;
  }

  .also__body {
    padding: 0 6px 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faqcard {
    margin-top: 18px;
    padding: 22px clamp(20px, 3vw, 32px);
    border-radius: 22px;
    background: var(--c-mint);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 28px;
    transition: background-color 0.15s ease;
  }

  .faqcard:hover {
    background: var(--c-blush);
    color: inherit;
  }

  .faqcard__text {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .faqcard__title {
    font-size: clamp(19px, 1.7vw, 22px);
    font-weight: 700;
    color: var(--c-ink);
  }

  .faqcard__lead {
    font-size: 16px;
    line-height: 1.55;
    color: var(--c-ink);
  }

  .faqcard__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 16px;
    font-weight: 600;
    color: var(--c-navy);
  }

  .faqcard__arrow {
    color: var(--c-coral);
  }
</style>
