---
import Base from '../layouts/Base.astro';
import HomeView from '../views/HomeView.astro';
import ClinicsView from '../views/ClinicsView.astro';
import ConditionsView from '../views/ConditionsView.astro';
import ArticleView from '../views/ArticleView.astro';
import AboutView from '../views/AboutView.astro';
import FaqView from '../views/FaqView.astro';
import PrivacyView from '../views/PrivacyView.astro';
import { locales } from '../i18n/config';
import { pageKeys, pageSlugParam, type PageKey } from '../i18n/routes';
import { assertContentIntegrity, getSingleton } from '../lib/content';
import { getArticles, getArticleSlugs } from '../lib/articles';

// One route generates every page in every language from the table in src/i18n/routes.ts,
// plus one page per article per language. The pages not built yet render a placeholder.
export async function getStaticPaths() {
  await assertContentIntegrity(); // a broken link between content stops the build
  const pages = locales.flatMap((locale) =>
    pageKeys.map((page) => ({
      params: { slug: pageSlugParam(page, locale) },
      props: { locale, page, articleId: undefined as string | undefined },
    })),
  );
  const articles = (
    await Promise.all(
      locales.map(async (locale) =>
        (await getArticles(locale)).map((article) => ({
          params: { slug: `${pageSlugParam('conditions', locale)}/${article.slug}` },
          props: { locale, page: 'conditions' as PageKey, articleId: article.id as string | undefined },
        })),
      ),
    )
  ).flat();
  return [...pages, ...articles];
}

const { locale, page, articleId } = Astro.props;

const article = articleId ? (await getArticles(locale)).find((a) => a.id === articleId) : undefined;
const articleSlugs = articleId ? await getArticleSlugs(articleId) : undefined;

async function titleAndLead(key: PageKey) {
  switch (key) {
    case 'home': {
      const { hero } = await getSingleton('pageHome', locale);
      return { title: hero.title, lead: hero.lead };
    }
    case 'clinics': {
      const { header } = await getSingleton('pageClinics', locale);
      return { title: header.title, lead: header.lead };
    }
    case 'conditions': {
      const { header } = await getSingleton('pageConditions', locale);
      return { title: header.title, lead: header.lead };
    }
    case 'about': {
      const { hero } = await getSingleton('pageAbout', locale);
      return { title: hero.name, lead: hero.subtitle };
    }
    case 'faq': {
      const { header } = await getSingleton('pageFaq', locale);
      return { title: header.title, lead: header.lead };
    }
    case 'privacy': {
      const { title } = await getSingleton('legal', locale);
      return { title, lead: '' };
    }
  }
}
const base = await titleAndLead(page);
const title = article?.title ?? base.title;
const lead = article?.summary ?? base.lead;

// The closing CTA is not shown on the clinics and articles overview pages
const showCta = article ? true : page !== 'clinics' && page !== 'conditions';
---

<Base
  locale={locale}
  page={{ page, articleSlugs }}
  title={title}
  description={lead || undefined}
  showCta={showCta}
  ctaFaqLink={page !== 'faq'}
  ctaTight={page === 'home'}
>
  {
    article ? (
      <ArticleView locale={locale} article={article} />
    ) : page === 'home' ? (
      <HomeView locale={locale} />
    ) : page === 'clinics' ? (
      <ClinicsView locale={locale} />
    ) : page === 'conditions' ? (
      <ConditionsView locale={locale} />
    ) : page === 'about' ? (
      <AboutView locale={locale} />
    ) : page === 'faq' ? (
      <FaqView locale={locale} />
    ) : (
      <PrivacyView locale={locale} />
    )
  }
</Base>
